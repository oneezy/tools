{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skills-sync.entrypoints.json",
  "type": "object",
  "required": ["version", "blocks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "type": "object",
          "required": ["source", "skill", "agents"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "skill": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "agents": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["codex", "claude-code"] }
            },
            "requiredFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
