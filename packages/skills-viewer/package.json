{
  "name": "skills-viewer",
  "version": "0.2.0",
  "description": "Statically analyze an agent skills library or plugin (a local folder or a GitHub repo) into a JSON map, plus a self-contained visual map: entry points, what each skill does, what it calls, and the plugin's commands, agents, hooks and MCP servers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneezy/tools.git",
    "directory": "packages/skills-viewer"
  },
  "bin": {
    "skills-viewer": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "default": "./dist/src/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vp test run",
    "start": "node dist/src/cli.js",
    "fixture": "node dist/src/cli.js fixtures/mattpocock-skills --out examples/mattpocock --no-open"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
